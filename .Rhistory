library(rstanarm)
data(bachmaier.nitrogen)
dat <- bachmaier.nitrogen
library(agridat)
library(rstanarm)
data(bachmaier.nitrogen)
dat <- bachmaier.nitrogen
# Fit a quadratic model for the low-fertility zone
dlow <- subset(dat, zone=="low")
m1 <- lm(yield ~ nitro + I(nitro^2), dlow)
m2 <- stan_glm(yield ~ nitro + I(nitro^2), data = dlow, family = gaussian())
summary(m2)
help('summary.stanreg')
# Part c
posterior_interval(m2, prob = 0.95, pars = c("nitro", "I(nitro^2)"))
# Part b
prior_summary(m2)
alpha <- 487.5
beta <- 561.5
credible_interval <- qbeta(c(0.025, 0.975), alpha, beta)
credible_interval
num_simulations <- 10000
# Simulate from the posterior distributions of θ1, θ2, θ3, θ4
simulated_theta1 <- rbeta(num_simulations, 487.5, 561.5)
simulated_theta2 <- rbeta(num_simulations, 628.5, 733.5)
simulated_theta3 <- rbeta(num_simulations, 526.5, 671.5)
simulated_theta4 <- rbeta(num_simulations, 553.5, 643.5)
# Compute µ for each simulation
simulated_mu <- simulated_theta1 - (simulated_theta2 + simulated_theta3 + simulated_theta4) / 3
# Estimate the probability that µ is greater than 0
p_mu_greater_than_0 <- mean(simulated_mu > 0)
# Display the estimated probability
p_mu_greater_than_0
summary(m2)
p1 <- c(5.9, 6.8, 6.4, 7.0, 6.6, 7.7, 7.2)
p2 <- c(6.9, 9.0, 6.6, 8.1, 9.3, 9.2, 8.6)
p3 <- c(5.3, 5.6, 5.5, 5.1, 6.2, 5.8, 5.8)
num_simulations <- 10000
# Period 1
n1 <- length(p1)
x1_bar <- mean(p1)
s1 <- sd(p1)
mu_1 <- x1_bar + (s1/sqrt(n1)) * rt(num_simulations, n1 - 1)
n2 <- length(p2)
x2_bar <- mean(p2)
s2 <- sd(p2)
mu_2 <- x2_bar + (s2/sqrt(n2)) * rt(num_simulations, n2 - 1)
# Period 3
n3 <- length(p3)
x3_bar <- mean(p3)
s3 <- sd(p3)
mu_3 <- x3_bar + (s3/sqrt(n3)) * rt(num_simulations, n3 - 1)
par(mfrow=c(1, 3))
hist(mu1, main="Period 1")
par(mfrow=c(1, 3))
hist(mu_1, main="Period 1")
hist(mu_2, main="Period 2")
hist(mu_3, main="Period 3")
summary(mu_1)
summary(mu_2)
summary(mu_3)
posterior_interval(mu_1)
summary(mu_1)
ci_2 <- quantile(mu_2, probs = c(0.025, 0.975))
ci_3 <- quantile(mu_3, probs = c(0.025, 0.975))
print(ci_1, ci_2, ci_3)
ci_1 <- quantile(mu_1, probs = c(0.025, 0.975))
ci_2 <- quantile(mu_2, probs = c(0.025, 0.975))
ci_3 <- quantile(mu_3, probs = c(0.025, 0.975))
print(ci_1, ci_2, ci_3)
print(ci_1)
print(ci_2)
print(ci_3)
# Part c
posterior_interval(m2, prob = 0.95, pars = c("nitro", "I(nitro^2)"))
